{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft attest --json",
  "oneOf": [
    {
      "type": "object",
      "required": ["changeset", "check", "passed", "url"],
      "additionalProperties": false,
      "properties": {
        "changeset": {"type": "string", "pattern": "^[a-z][0-9a-f]{64}$"},
        "check": {"type": "string"},
        "passed": {"type": "boolean"},
        "url": {"type": "string"}
      }
    },
    {
      "type": "object",
      "required": ["changeset", "kind", "status", "name", "url"],
      "additionalProperties": false,
      "properties": {
        "changeset": {"type": "string", "pattern": "^[a-z][0-9a-f]{64}$"},
        "kind": {"enum": ["check", "review", "approval"]},
        "status": {"enum": ["pass", "fail", "pending", "error"]},
        "name": {"type": "string"},
        "url": {"type": "string"}
      }
    }
  ]
}
