{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft error (any command, --json)",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      }
    }
  }
}
