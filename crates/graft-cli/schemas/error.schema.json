{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft error (any command, --json)",
  "type": "object",
  "required": [
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "error": {
      "type": "object",
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "onto": {
          "description": "Conflicts: the tip the stack conflicts with.",
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        },
        "base": {
          "description": "A line merge conflict (D29): the merge base.",
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        },
        "source": {
          "description": "A line merge conflict (D29): the source changeset merged.",
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        },
        "merged_from": {
          "description": "A line merge conflict written with `--sync` (D29): the `<line>@<changeset>` to land the resolution with, as `graft land --merged-from`.",
          "type": "string"
        },
        "conflicts": {
          "description": "Conflicts: the paths, and how a sync wrote each (null when nothing was written).",
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "path",
              "mode"
            ],
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string"
              },
              "mode": {
                "enum": [
                  "markers",
                  "sidecar",
                  "merged",
                  "skipped",
                  null
                ]
              }
            }
          }
        },
        "preflight": {
          "$ref": "#/$defs/preflight"
        }
      }
    }
  },
  "$defs": {
    "preflight": {
      "description": "The pre-land check (design \u00a78.8, D27). `checked` is false when --no-check (or no stack) skipped it.",
      "type": "object",
      "required": [
        "checked"
      ],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "tip": {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        },
        "stop": {
          "type": "boolean"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts_truncated": {
          "type": "boolean"
        },
        "merges_cleanly": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "both_changed_truncated": {
          "type": "boolean"
        },
        "drafts": {
          "type": "object",
          "required": [
            "checked",
            "skipped",
            "overlaps",
            "truncated"
          ],
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "skipped": {
              "type": [
                "string",
                "null"
              ]
            },
            "overlaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "workspace",
                  "owner",
                  "session",
                  "work_item",
                  "draft_age_ms",
                  "lease_until_ms",
                  "paths",
                  "paths_truncated"
                ],
                "additionalProperties": false,
                "properties": {
                  "workspace": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "session": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "work_item": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "draft_age_ms": {
                    "type": "integer"
                  },
                  "lease_until_ms": {
                    "type": "integer"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "paths_truncated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        "preview_skipped": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
