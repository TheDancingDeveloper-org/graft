{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft land --json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "outcome",
        "line",
        "landed",
        "rebased",
        "changed",
        "pr_url",
        "recovered",
        "preflight"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "landed"
        },
        "line": {
          "type": "string"
        },
        "landed": {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$",
          "description": "A changeset id: a kind letter and 64 lowercase hex digits."
        },
        "rebased": {
          "type": "boolean"
        },
        "changed": {
          "type": "integer",
          "minimum": 0
        },
        "pr_url": {
          "type": "null"
        },
        "recovered": {
          "description": "An interrupted commit the command found first: finished, rolled back, or none.",
          "enum": [
            "finished",
            "rolled_back",
            null
          ]
        },
        "preflight": {
          "$ref": "#/$defs/preflight"
        }
      }
    },
    {
      "type": "object",
      "required": [
        "outcome",
        "line",
        "landed",
        "rebased",
        "changed",
        "pr_url",
        "recovered",
        "preflight"
      ],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "const": "queued"
        },
        "line": {
          "type": "string"
        },
        "landed": {
          "type": "null"
        },
        "rebased": {
          "type": "null"
        },
        "changed": {
          "type": "null"
        },
        "pr_url": {
          "type": "string"
        },
        "recovered": {
          "description": "An interrupted commit the command found first: finished, rolled back, or none.",
          "enum": [
            "finished",
            "rolled_back",
            null
          ]
        },
        "preflight": {
          "$ref": "#/$defs/preflight"
        }
      }
    }
  ],
  "$defs": {
    "preflight": {
      "description": "The pre-land check (design \u00a78.8, D27). `checked` is false when --no-check (or no stack) skipped it.",
      "type": "object",
      "required": [
        "checked"
      ],
      "properties": {
        "checked": {
          "type": "boolean"
        },
        "pre_land_check": {
          "description": "What ran: `rebase` is the dry-run conflict preview (needs only what a land needs), `overlap` the draft-overlap read (needs repo:<r>:drafts). Each is `ran`, `not_needed` (rebase only: the stack is on the tip) or `skipped(<why>)`.",
          "type": "object",
          "required": [
            "rebase",
            "overlap"
          ],
          "additionalProperties": false,
          "properties": {
            "rebase": {
              "type": "string",
              "pattern": "^(ran|not_needed|skipped\\([a-z-]+\\))$"
            },
            "overlap": {
              "type": "string",
              "pattern": "^(ran|skipped\\([a-z-]+\\))$"
            }
          }
        },
        "tip": {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        },
        "stop": {
          "type": "boolean"
        },
        "conflicts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "conflicts_truncated": {
          "type": "boolean"
        },
        "merges_cleanly": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "both_changed_truncated": {
          "type": "boolean"
        },
        "drafts": {
          "type": "object",
          "required": [
            "checked",
            "skipped",
            "overlaps",
            "truncated"
          ],
          "additionalProperties": false,
          "properties": {
            "checked": {
              "type": "boolean"
            },
            "skipped": {
              "type": [
                "string",
                "null"
              ]
            },
            "overlaps": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "workspace",
                  "owner",
                  "session",
                  "work_item",
                  "draft_age_ms",
                  "lease_until_ms",
                  "paths",
                  "paths_truncated"
                ],
                "additionalProperties": false,
                "properties": {
                  "workspace": {
                    "type": "string"
                  },
                  "owner": {
                    "type": "string"
                  },
                  "session": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "work_item": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "draft_age_ms": {
                    "type": "integer"
                  },
                  "lease_until_ms": {
                    "type": "integer"
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "paths_truncated": {
                    "type": "boolean"
                  }
                }
              }
            },
            "truncated": {
              "type": "boolean"
            }
          }
        },
        "preview_skipped": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
