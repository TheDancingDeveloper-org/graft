{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft ci exchange --json",
  "description": "Where the graft token was written. The token itself is never printed.",
  "type": "object",
  "required": [
    "provider",
    "changeset",
    "token_file"
  ],
  "additionalProperties": false,
  "properties": {
    "provider": {
      "enum": [
        "github",
        "woodpecker"
      ]
    },
    "changeset": {
      "description": "The changeset the token is pinned to, or null.",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$"
        }
      ]
    },
    "token_file": {
      "type": "string"
    }
  }
}
