{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft ls --json",
  "type": "object",
  "required": [
    "entries",
    "next",
    "at",
    "path"
  ],
  "additionalProperties": false,
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "kind",
          "id"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "file",
              "exec",
              "symlink",
              "tree",
              "submodule"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$",
            "description": "An object id, as 64 lowercase hex digits."
          }
        }
      }
    },
    "next": {
      "type": [
        "string",
        "null"
      ]
    },
    "at": {
      "type": "string",
      "pattern": "^[a-z][0-9a-f]{64}$",
      "description": "A changeset id: a kind letter and 64 lowercase hex digits."
    },
    "path": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
