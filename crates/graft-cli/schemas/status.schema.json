{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft status --json",
  "type": "object",
  "required": [
    "line",
    "base",
    "head",
    "clean",
    "changes"
  ],
  "additionalProperties": false,
  "properties": {
    "line": {
      "type": "string"
    },
    "base": {
      "type": "string",
      "pattern": "^[a-z][0-9a-f]{64}$",
      "description": "A changeset id: a kind letter and 64 lowercase hex digits."
    },
    "head": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$",
          "description": "A changeset id: a kind letter and 64 lowercase hex digits."
        },
        {
          "type": "null"
        }
      ]
    },
    "clean": {
      "type": "boolean"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string"
          },
          "status": {
            "enum": [
              "added",
              "modified",
              "deleted"
            ]
          }
        }
      }
    }
  }
}
