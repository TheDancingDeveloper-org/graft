{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft workspace show|open|renew|close --json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "name",
        "owner",
        "session",
        "line",
        "base",
        "head",
        "lease_until_ms"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "session": {
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "type": "string"
        },
        "base": {
          "type": "string",
          "pattern": "^[a-z][0-9a-f]{64}$",
          "description": "A changeset id: a kind letter and 64 lowercase hex digits."
        },
        "head": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z][0-9a-f]{64}$",
              "description": "A changeset id: a kind letter and 64 lowercase hex digits."
            },
            {
              "type": "null"
            }
          ]
        },
        "lease_until_ms": {
          "type": "integer"
        },
        "opened": {
          "type": "boolean",
          "description": "Present for `workspace open`: whether a workspace was opened (false: the existing one was renewed)."
        }
      }
    },
    {
      "type": "object",
      "required": [
        "name",
        "closed"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string"
        },
        "closed": {
          "const": true
        }
      }
    }
  ]
}
