{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft pick --json",
  "type": "object",
  "required": [
    "picked",
    "id",
    "workspace",
    "changed",
    "recovered"
  ],
  "additionalProperties": false,
  "properties": {
    "picked": {
      "type": "string",
      "pattern": "^[a-z][0-9a-f]{64}$",
      "description": "The landed changeset re-applied."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][0-9a-f]{64}$",
      "description": "The new draft, now the workspace head."
    },
    "workspace": {
      "type": "string"
    },
    "changed": {
      "type": "integer",
      "minimum": 0
    },
    "recovered": {
      "description": "An interrupted commit the command found first: finished, rolled back, or none.",
      "enum": [
        "finished",
        "rolled_back",
        null
      ]
    }
  }
}
