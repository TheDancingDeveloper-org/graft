{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "graft version --json",
  "type": "object",
  "required": [
    "version",
    "protocol"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string"
    },
    "protocol": {
      "type": "object",
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": false,
      "properties": {
        "major": {
          "type": "integer",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
